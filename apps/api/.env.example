NODE_ENV=development
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://ai_logistics:ai_logistics@localhost:5432/ai_logistics
JWT_ACCESS_SECRET=replace-with-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-at-least-32-characters
REDIS_URL=redis://127.0.0.1:6379
THROTTLE_DEFAULT_LIMIT=60
THROTTLE_DEFAULT_TTL_MINUTES=1
THROTTLE_ASSISTANT_RESPOND_LIMIT=10
THROTTLE_ASSISTANT_RESPOND_TTL_MINUTES=1
THROTTLE_ASSISTANT_JOBS_CREATE_LIMIT=10
THROTTLE_ASSISTANT_JOBS_CREATE_TTL_MINUTES=1
THROTTLE_DOCUMENTS_UPLOAD_LIMIT=5
THROTTLE_DOCUMENTS_UPLOAD_TTL_MINUTES=10
THROTTLE_DOCUMENTS_INITIATE_UPLOAD_LIMIT=10
THROTTLE_DOCUMENTS_INITIATE_UPLOAD_TTL_MINUTES=10
THROTTLE_DOCUMENTS_COMPLETE_UPLOAD_LIMIT=10
THROTTLE_DOCUMENTS_COMPLETE_UPLOAD_TTL_MINUTES=10
THROTTLE_AUTH_REGISTER_LIMIT=3
THROTTLE_AUTH_REGISTER_TTL_MINUTES=15
THROTTLE_AUTH_LOGIN_LIMIT=5
THROTTLE_AUTH_LOGIN_TTL_MINUTES=1
THROTTLE_AUTH_REFRESH_LIMIT=20
THROTTLE_AUTH_REFRESH_TTL_MINUTES=1
THROTTLE_AUTH_SOCKET_TOKEN_LIMIT=30
THROTTLE_AUTH_SOCKET_TOKEN_TTL_MINUTES=1
OPENAI_DOCUMENT_MODEL=gpt-4.1-mini
STORAGE_PROVIDER=s3
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=documents
S3_PUBLIC_BASE_URL=http://127.0.0.1:9000
S3_USE_SSL=false
S3_PRESIGN_TTL_SECONDS=900
