    {
      "name": "Loads",
      "item": [
        {
          "name": "List Loads",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/loads?page=1&limit=10&status=pending",
              "host": ["{{baseUrl}}"],
              "path": ["loads"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "status", "value": "pending", "disabled": true },
                { "key": "search", "value": "Denver", "disabled": true },
                { "key": "pickupFrom", "value": "2026-06-01", "disabled": true },
                { "key": "pickupTo", "value": "2026-06-30", "disabled": true }
              ]
            },
            "description": "List loads with optional search, status, driver, pickup period, and pagination filters."
          },
          "response": []
        },
        {
          "name": "Create Load",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data?.id) pm.collectionVariables.set('loadId', body.data.id);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
